{
  "name": "node-express-ts-starter",
  "private": true,
  "version": "1.0.0",
  "description": "Production-oriented Node.js, Express, and TypeScript starter template",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.5.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.5.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.8",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "6.2.12",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "redis": "6.3.0",
    "zod": "^4.6.5"
  }
}
